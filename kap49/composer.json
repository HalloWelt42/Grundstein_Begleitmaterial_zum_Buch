{
    "name": "grundstein/kap49",
    "description": "Testbaren Code schreiben - Dependency Injection als Testhilfe",
    "type": "project",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "nachher/src/",
            "App\\Vorher\\": "vorher/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
