{
    "name": "grundstein/kap60",
    "description": "Caching - Begleitmaterial zu Kapitel 60",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "App\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Cache\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
