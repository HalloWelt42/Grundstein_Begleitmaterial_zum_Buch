{
    "name": "grundstein/kap61",
    "description": "Lange Prozesse: Worker, Queues und Signale - eine datenbankgestützte Auftragswarteschlange",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
