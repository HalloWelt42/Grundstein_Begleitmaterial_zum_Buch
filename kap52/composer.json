{
    "name": "grundstein/kap52",
    "description": "Dependency Injection und Container - ein kleiner PSR-11-Container von Hand",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
