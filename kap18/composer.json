{
    "name": "grundstein/kap18",
    "description": "Beispielprojekt zu Namespaces und Autoloading",
    "type": "project",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
