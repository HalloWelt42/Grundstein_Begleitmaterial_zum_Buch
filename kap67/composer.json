{
    "name": "grundstein/kap67",
    "description": "Internationalisierung - Zahlen, Datum, Währung und Text mit der intl-Erweiterung",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "ext-intl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
