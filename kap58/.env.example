# Grundstein - Kapitel 58: durchgängiges Beispielprojekt
#
# Vorlage für die Umgebungsdatei. Kopiere sie zu .env und passe die Werte an.
# Die echte .env gehört NICHT ins Versionsverzeichnis - hier stehen nur
# Platzhalter, niemals echte Geheimnisse.

# Name der Anwendung (erscheint in Ausgaben und Protokollen).
APP_NAME=Grundstein Bestellannahme

# Umgebung: entwicklung oder produktion. In der Entwicklung legt die
# Anwendung das Datenbankschema selbst an.
APP_UMGEBUNG=entwicklung

# PDO-Verbindungszeichenkette (DSN). Voreinstellung ist eine flüchtige
# SQLite-Datenbank im Arbeitsspeicher. Für eine dauerhafte Datei:
#   sqlite:/pfad/zu/bestellungen.sqlite
DB_DSN=sqlite::memory:
