{
    "name": "grundstein/kap47-pest",
    "description": "Pest-Tests für den Warenkorb",
    "type": "project",
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
