{
    "name": "grundstein/kap58",
    "description": "Durchgängiges Beispielprojekt - Schichten, Domäne, Ports und Adapter, Container, Ereignisse und Konfiguration in einer lauffähigen Anwendung",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
