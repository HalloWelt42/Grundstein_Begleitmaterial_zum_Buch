{
    "name": "grundstein/kap51",
    "description": "Continuous Integration - die Prüfkette bei jedem Push",
    "type": "project",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "stil": "php-cs-fixer fix --dry-run --diff",
        "pruefe": [
            "@test",
            "@analyse",
            "@stil"
        ]
    }
}
