# Grundstein - Kapitel 57: Beispiel-Umgebungsdatei
#
# Kopiere diese Datei nach .env und trage deine echten Werte ein:
#     cp .env.example .env
#
# Die echte .env wird NICHT eingecheckt (siehe .gitignore). Hier stehen nur
# Platzhalter - niemals ein echtes Geheimnis.

# Umgebung: dev, test oder prod
APP_ENV=dev

# Fehlerausgabe - in der Produktion immer aus
APP_DEBUG=true

# Datenbank-Adresse. Ein Passwort gehört NICHT in diese Beispieldatei.
DB_DSN="sqlite::memory:"

# Absenderadresse für ausgehende Mails
MAIL_FROM="team@meine-firma.test"

# Geheimnis: hier nur ein Platzhalter, der echte Schlüssel gehört in die .env
API_KEY=dein-api-schluessel-hier
